# Narrative certificate generation (run: npm run cert:generate)
NARRATIVE_PERSON_DSID=your-personal-dsid
NARRATIVE_SYSTEM_DSID=your-system-user-dsid

# Whisper secret configuration
WHISPER_SECRET_NAME=your-whisper-secret-name
WHISPER_NAMESPACE=your-whisper-namespace

# Optional: CA cert path (uncomment if needed for corporate proxy)
# WHISPER_CLIENT_CA_PATH=./node_modules/@apple/node-corp-certs/certs.pem

# Optional: custom cert paths (defaults to ./cert/system-actor/)
# WHISPER_CLIENT_CERT_PATH=./cert/system-actor/cert.pem
# WHISPER_CLIENT_KEY_PATH=./cert/system-actor/private.pem

# Optional: log level (default: info)
# LOG_LEVEL=debug
