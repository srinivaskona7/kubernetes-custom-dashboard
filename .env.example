# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
LOG_LEVEL=info
# Sub-path the app is served under. Leave unset to serve at "/".
# BASE_PATH=/fleet-dashboard/
DB_PATH=/app/data/app.db

# ── Authentication ────────────────────────────────────────────────────────────
# none  — no authentication. Refused when NODE_ENV=production.
# oidc  — verify a bearer JWT against a public OIDC JWKS endpoint.
AUTH_MODE=none
# OIDC_JWKS_URL=https://login.example.com/.well-known/jwks.json
# OIDC_ISSUER=https://login.example.com/
# OIDC_AUDIENCE=k8s-fleet-dashboard
# Comma-separated groups (matched against the token's `groups` claim). Empty = any
# authenticated user. Must be a subset of what the issuer puts in the claim.
# ALLOWED_GROUPS=platform-engineering
# Groups allowed to mutate the fleet registry (add/remove clusters, renew tokens).
# FLEET_ADMIN_GROUPS=platform-admins

# ── Fleet storage ─────────────────────────────────────────────────────────────
# JSON file mounted from a Secret, if you keep the cluster registry as a file.
# APP_CONFIG_FILE=/etc/fleet-dashboard/config.json
# FLEET_CLUSTERS_FILE=./server/fleet/clusters.json

# ── Feature switches (all default to enabled) ─────────────────────────────────
# FLEET_ALLOW_ONBOARD=false
# FLEET_ALLOW_MANUAL_RENEW=false
# FLEET_ALLOW_ROLLOUT=false
# FLEET_RENEW_IN_PROCESS=false
