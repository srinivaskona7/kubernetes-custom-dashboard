{
  "name": "k8s-fleet-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only fleet dashboard for any conformant Kubernetes cluster (EKS, AKS, GKE, kind, OpenShift).",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"vite\"",
    "test": "vitest run",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "docker:build": "docker build -t ${IMAGE_REPO:-k8s-fleet-dashboard}:${IMAGE_TAG:-latest} .",
    "docker:run": "docker run --rm -p 3001:3001 -e AUTH_MODE=none ${IMAGE_REPO:-k8s-fleet-dashboard}:${IMAGE_TAG:-latest}",
    "helm:template": "helm template k8s-fleet-dashboard ./chart",
    "helm:lint": "helm lint ./chart",
    "helm:install": "helm upgrade --install k8s-fleet-dashboard ./chart -n fleet-dashboard --create-namespace --set image.repository=${IMAGE_REPO:-k8s-fleet-dashboard} --set image.tag=${IMAGE_TAG:-latest}"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.0",
    "jose": "^6.2.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  }
}
