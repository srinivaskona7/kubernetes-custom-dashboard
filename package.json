{
  "name": "platform-btp-kyma-fleet-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"vite\"",
    "test": "vitest run",
    "build": "vite build",
    "start": "NODE_EXTRA_CA_CERTS=./node_modules/@apple/node-corp-certs/certs.pem NODE_ENV=production node server/index.js",
    "cert:generate": "node scripts/generate-narrative-cert.cjs",
    "push": "bash scripts/push.sh",
    "wipe": "bash scripts/wipe.sh",
    "deploy:clean": "npm run wipe && npm run push",
    "docker:build": "docker buildx build --platform=linux/amd64 --load -t ${IMAGE_REPO:-btp-kyma-fleet-dashboard}:latest .",
    "ecr:login": "aws ecr get-login-password --region us-west-2 | docker login --username AWS --password-stdin 637248970961.dkr.ecr.us-west-2.amazonaws.com",
    "ecr:build": "docker buildx build --platform=linux/amd64 --load -t 637248970961.dkr.ecr.us-west-2.amazonaws.com/btp-kyma-fleet-dashboard:latest .",
    "ecr:push": "docker push 637248970961.dkr.ecr.us-west-2.amazonaws.com/btp-kyma-fleet-dashboard:latest",
    "ecr:deploy": "npm run ecr:login && npm run ecr:build && npm run ecr:push && kubectl rollout restart deployment btp-kyma-fleet-dashboard -n btp-kyma-fleet-dashboard && kubectl rollout status deployment btp-kyma-fleet-dashboard -n btp-kyma-fleet-dashboard",
    "helm:deploy": "helm upgrade --install btp-kyma-fleet-dashboard ./chart -n btp-kyma-fleet-dashboard --create-namespace --set image.repository=637248970961.dkr.ecr.us-west-2.amazonaws.com/btp-kyma-fleet-dashboard",
    "helm:deploy:dry-run": "helm upgrade --install btp-kyma-fleet-dashboard ./chart -n btp-kyma-fleet-dashboard --create-namespace --set image.repository=637248970961.dkr.ecr.us-west-2.amazonaws.com/btp-kyma-fleet-dashboard --dry-run --debug",
    "deploy": "npm run build && npm run ecr:deploy && npm run helm:deploy"
  },
  "dependencies": {
    "@apple/node-corp-certs": "^2.0.6",
    "axios": "^1.7.9",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.0",
    "jose": "^6.2.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  }
}
